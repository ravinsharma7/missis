        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-REF-002",
      "source": "7.2, 7.3",
      "text": "Human-readable references are aliases; logical and exact event references remain distinct.",
      "tests": [
        "TestTicketNumbering"
      ]
    },
    {
      "id": "PH1-REF-003",
      "source": "7.4",
      "text": "Stale paths must not silently retarget to a different part.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestStalePathDoesNotRetarget"
      ]
    },
    {
      "id": "PH1-REF-004",
      "source": "7.4",
      "text": "Stored links and provenance target canonical `PartID` values.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestResolvePartPath"
      ]
    },
    {
      "id": "PH1-BT-001",
      "source": "10.9",
      "text": "The bitemporal scalar winner is argmax of (effective_at, recorded_at, stream_sequence, event_id) over candidates visible at (V, K); backdated assertions correct intervals only.",
      "tests": [
        "TestBitemporalNormalUpdate",
        "TestBitemporalBackdatedUpdate",
        "TestBitemporalFutureUpdate",
        "TestBitemporalSameEffectiveTime",
        "TestBitemporalRetraction",
        "TestBitemporalBackdatedRetraction",
        "TestBitemporalSupersession",
        "TestBitemporalOutOfOrderImport"
      ]
    },
    {
      "id": "PH1-BT-002",
      "source": "10.9",
      "text": "Retraction is an interval hole: no value from its effective time until a later assertion wins, and it is invisible before it is recorded.",
      "tests": [
        "TestBitemporalRetraction",
        "TestBitemporalBackdatedRetraction"
      ]
    },
    {
      "id": "PH1-BT-003",
      "source": "10.9",
      "text": "A superseding event voids its target as soon as it is known, even before the superseder's effective time.",
      "tests": [
        "TestBitemporalSupersession"
      ]
    },
    {
      "id": "PH1-BT-004",
      "source": "10.9",
      "text": "Bitemporal reconstruction applies to hierarchy moves and link retractions, not only scalar values.",
      "tests": [
        "TestBitemporalOutOfOrderImport",
        "TestBitemporalBackdatedMove",
        "TestBitemporalBackdatedLinkRetraction"
      ]
    },
    {
      "id": "PH1-ENC-001",
      "source": "10.10",
      "text": "Canonical event encoding v1 defines deterministic language-independent bytes with fixed field order, UTC 9-digit timestamps, no HTML escaping, and domain-separated SHA-256 framing.",
      "tests": [
        "TestCanonicalEventBytesV1Vector",
        "TestComputeEventHashV1Vector"
      ]
    },
    {
      "id": "PH1-REG-001",
      "source": "19",
      "text": "Every declared operation has a registered descriptor with a validator; the registry is complete against the Op constants.",
      "tests": [
        "TestRegistryCompleteness"
      ]
    },
    {
      "id": "PH1-REG-002",
      "source": "19",
      "text": "Projection-neutral marker operations are declared explicitly, never silent no-ops.",
      "tests": [
        "TestRegistryMarkersAreExplicit"
      ]
    },
    {
      "id": "PH1-REG-003",
      "source": "19",
      "text": "Each operation validates its target kinds and required fields, and each CLI flag combination maps to exactly the expected operation.",
      "tests": [
        "TestOperationValidation",
        "TestCLIFlagsMapToOperations"
      ]
    },
    {
      "id": "PH1-REG-004",
      "source": "19",
      "text": "Unknown operations are rejected deterministically on append.",
      "tests": [
        "TestLookupOperationUnknown",
        "TestAppendRejectsUnknownOperation"
      ]
    },
    {
      "id": "PH1-REG-005",
      "source": "19",
      "text": "Marker operations change no projection state and remain visible in history/provenance output.",
      "tests": [
        "TestMarkerOperationsAreProjectionNeutral",
        "TestMarkerVisibleInHistory"
      ]
    },
    {
      "id": "PH1-FMT-001",
      "source": "34.1",
      "text": "A store is compatibility-probed before mutation, rejects unsupported revisions, and is covered by an immutable complete compatibility corpus.",
      "tests": [
        "TestInspectImplicitStoreFormatRevisions",
        "TestOpenMigratesFormatWithoutChangingLedger",
        "TestUnsupportedFormatFailsBeforeWALOrIntegrity",
        "TestCompatibilityFixtureCompleteness",
        "TestCompatibilityFixtureFresh",
        "TestCompatibilityFixtureOpenBackupAndArtifacts"
      ]
    },
    {
      "id": "PH1-REL-001",
      "source": "34.2",
      "text": "Stable releases pair missis and missis-tools from one commit and self-update only after manifest, archive, binary identity, and checksum verification.",
      "tests": [
        "TestCheckVersionOrderingAndDevelopmentGuard",
        "TestReleaseManifestValidation",
        "TestDownloadRejectsTampering",
        "TestInstallPublishesVerifiedPairAndManifest",
        "TestRecoverRollsBackInterruptedPair"
      ]
    },
    {
      "id": "PH1-SETUP-001",
      "source": "34.3",
      "text": "Setup validates the in-project store before atomically publishing the marker and is idempotent on retry.",
      "tests": ["TestSetupFreshAndRepeat"]
    },
    {
      "id": "PH1-SETUP-002",
      "source": "34.3",
      "text": "Setup check mode performs read-only compatibility, consistency, and scope verification.",
      "tests": ["TestSetupCheckIsReadOnly"]
    },
    {
      "id": "PH1-SETUP-003",
      "source": "34.3",
      "text": "Stable setup requires a verified paired installation; development use requires an explicit exception.",
      "tests": ["TestSetupRequiresExplicitDevelopment"]
    },
    {
      "id": "PH1-SETUP-004",
      "source": "34.3",
      "text": "Clean bootstrap uses one explicitly pinned stable ref and invokes setup through the installed absolute binary.",
      "tests": ["TestPairedInstallRefSelection"]
    }
  ],
