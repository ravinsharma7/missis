  "phase1_should_decisions": [
    {"id":"N002","decision":"adopt","reason":"Common JSON, actor, and effective-time options are required for a useful Phase 1 CLI.","target":"CLI and black-box tests"},
    {"id":"N004","decision":"adopt","reason":"Coordination status is restricted to open, doing, blocked, and done.","target":"validation and CLI tests"},
    {"id":"N005","decision":"adopt","reason":"Blocked status requires a reason.","target":"validation and CLI tests"},
    {"id":"N006","decision":"adopt","reason":"Workflow-specific status proliferation is rejected.","target":"validation tests"},
    {"id":"N009","decision":"adopt","reason":"Arbitrary parts and conventional names are required by the model.","target":"model projection tests"},
    {"id":"N012","decision":"adopt","reason":"A part has one current structural parent.","target":"model and black-box tests"},
    {"id":"N014","decision":"adopt","reason":"Status applies to tickets, not subparts.","target":"model behavior"},
    {"id":"N015","decision":"adopt","reason":"Phase 1 stores basic text, scalar, and status value kinds.","target":"store and JSON tests"},
    {"id":"N019","decision":"adopt","reason":"Recursive retraction is one atomic batch.","target":"store and black-box tests"},
    {"id":"N022","decision":"adopt","reason":"Canonical IDs require collision-resistant random generation.","target":"model and store tests"},
    {"id":"N024","decision":"adopt","reason":"Canonical part IDs remain resolvable without a current path.","target":"model tests"},
    {"id":"N028","decision":"adopt","reason":"Stale paths fail structurally instead of retargeting.","target":"model and CLI tests"},
    {"id":"N029","decision":"adopt","reason":"Events and provenance store canonical IDs.","target":"store tests"},
    {"id":"N042","decision":"adopt","reason":"Effective-time and knowledge-time queries are required for the temporal kernel.","target":"CLI and temporal tests"},
    {"id":"N044","decision":"defer","reason":"Local timezone rendering is not required by the first kernel.","target":"Phase 1 follow-up or later"},
    {"id":"N047","decision":"adopt","reason":"Per-stream sequences are a core integrity guarantee.","target":"store tests"},
    {"id":"N049","decision":"adopt","reason":"Removal is represented by immutable retraction events.","target":"store and model tests"},
    {"id":"N051","decision":"adopt","reason":"Corrections identify the superseded event and reason.","target":"store and model tests"},
    {"id":"N052","decision":"defer","reason":"Semantic temporal diff follows the history projection.","target":"later show work"},
    {"id":"N053","decision":"adopt","reason":"Recursive and multi-event operations share a batch identity.","target":"store tests"},
    {"id":"N055","decision":"adopt","reason":"Actor, effective time, batch, supersession, and reason fields are foundational provenance.","target":"store and model tests"},
    {"id":"N057","decision":"adopt","reason":"Stable human and agent actor references are required for provenance.","target":"CLI tests"},
    {"id":"N058","decision":"defer","reason":"External effect capture depends on the processor and effects layer.","target":"Phase 6 or later"},
    {"id":"N106","decision":"adopt","reason":"Trust-boundary validation must happen before writes.","target":"CLI and model tests"},
    {"id":"N107","decision":"adopt","reason":"Scalar updates need expected-revision checks.","target":"concurrency tests"},
    {"id":"N108","decision":"adopt","reason":"Hierarchy mutations need expected-revision checks.","target":"concurrency tests"},
    {"id":"N109","decision":"adopt","reason":"Subtree moves and recursive retractions must commit atomically.","target":"concurrency tests"},
    {"id":"N110","decision":"adopt","reason":"Independent additions should commute.","target":"concurrency tests"},
    {"id":"N111","decision":"adopt","reason":"One user operation produces one atomic batch.","target":"store tests"},
    {"id":"N112","decision":"adopt","reason":"Creation and mutation require idempotency keys.","target":"idempotency tests"},
    {"id":"N113","decision":"adopt","reason":"Automation requires structured JSON errors.","target":"CLI and black-box tests"}
  ],
  "requirements": [
    {
      "id": "PH1-ACC-001",
      "source": "29.1, 29.2, 29.3, 29.4, 29.11",
      "text": "Phase 1 acceptance criteria are mapped to the requirements above.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-CLI-001",
      "source": "5.1, 5.2",
      "text": "`missis` exposes only `new`, `show`, and `set` as top-level domain subcommands; a small allowlist of global operational flags is allowed.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-CLI-002",
      "source": "5.2",
      "text": "Commands support `--json`, `--format text\\",
      "tests": [
        "TestNewShowSetLifecycle",
        "TestShowVersion"
      ]
    },
    {
      "id": "PH1-CLI-003",
      "source": "5.2",
      "text": "`recorded_at` is system-assigned; callers cannot forge transaction time.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-CLI-004",
      "source": "5.3",
      "text": "No operation depends on an implicit current ticket.",
      "tests": [
        "TestNewRequiresTitle",
        "TestNewShowSetLifecycle",
        "TestSetRequiresReference"
      ]
    },
    {
      "id": "PH1-CLI-005",
      "source": "5.4, 5.5, 5.6",
      "text": "`new`, `show`, and `set` cover identity creation, projection, and Phase 1 mutations.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-CLI-006",
      "source": "22",
      "text": "Exit classes and structured JSON errors are part of the stable contract.",
      "tests": [
        "TestBlockedRequiresReason",
        "TestStorageFailureExitCode",
        "TestStructuredJSONErrorShape"
      ]
    },
    {
      "id": "PH1-CLI-007",
      "source": "5.7",
      "text": "Default coordination statuses are `open`, `doing`, `blocked`, and `done`; avoid status proliferation.",
      "tests": [
        "TestBlockedRequiresReason"
      ]
    },
    {
      "id": "PH1-CLI-008",
      "source": "5.7",
      "text": "A blocked ticket has a reason or dependency.",
      "tests": [
        "TestBlockedRequiresReason"
      ]
    },
    {
      "id": "PH1-CON-001",
      "source": "21.1, 21.2",
      "text": "Scalar and hierarchy updates support expected-revision checks.",
      "tests": [
        "TestMultiProcessConcurrency"
      ]
    },
    {
      "id": "PH1-CON-002",
      "source": "21.2, 20.1",
      "text": "Concurrent hierarchy mutations are atomic and reject cycles or path collisions.",
      "tests": [
        "TestCycleRejected",
        "TestMultiProcessConcurrency"
      ]
    },
    {
      "id": "PH1-CON-003",
      "source": "21.3",
      "text": "Independent additions may commute without unnecessary conflict.",
      "tests": [
        "TestAddListAppend"
      ]
    },
    {
      "id": "PH1-CON-004",
      "source": "21.5",
      "text": "Clients can use idempotency keys.",
      "tests": [
        "TestIdempotency",
        "TestOptimisticConflict"
      ]
    },
    {
      "id": "PH1-DM-001",
      "source": "18",
      "text": "Go data model defines every Phase 1 entity and projection type.",
      "tests": [
        "TestNewShowSetLifecycle",
        "TestProjectionRenameMoveRetract"
      ]
    },
    {
      "id": "PH1-DM-002",
      "source": "18",
      "text": "Projection and validation functions have concrete signatures.",
      "tests": [
        "TestTicketNumbering"
      ]
    },
    {
      "id": "PH1-EVT-001",
      "source": "10.2, 10.4, 20.3-4",
      "text": "Every accepted event has a unique immutable ID, actor, `recorded_at`, and `effective_at`.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-EVT-002",
      "source": "10.3, 20.2",
      "text": "Timestamps use unambiguous absolute storage and RFC 3339 output; per-stream sequence is monotonic.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-EVT-003",
      "source": "20.3-1",
      "text": "Accepted historical events are append-only and immutable.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-EVT-004",
      "source": "10.5, 20.3-6",
      "text": "Retraction removes current state without erasing historical queryability.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-EVT-005",
      "source": "10.6",
      "text": "Corrections identify the events they supersede.",
      "tests": [
        "TestSupersession"
      ]
    },
    {
      "id": "PH1-EVT-006",
      "source": "10.8, 21.4",
      "text": "Multi-event batches are atomic by default.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-EVT-007",
      "source": "19",
      "text": "Internal event operation vocabulary drives projection and validation without new CLI commands.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-EVT-008",
      "source": "20.1, 20.2",
      "text": "Append preconditions and postconditions are enforced before durability success.",
      "tests": [
        "TestShowHealth",
        "TestValidateAppendRejectsCycleAndCollision"
      ]
    },
    {
      "id": "PH1-PART-001",
      "source": "6.1, 6.2, 20.3-13",
      "text": "There is one recursive `Part` entity; no separate `Subpart` entity.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestProjectionRenameMoveRetract"
      ]
    },
    {
      "id": "PH1-PART-002",
      "source": "6.1",
      "text": "A part may have a value only, children only, or both.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PART-003",
      "source": "6.5, 7.3",
      "text": "Every part has a stable canonical ID independent of its human-readable path.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestProjectionRenameMoveRetract"
      ]
    },
    {
      "id": "PH1-PART-004",
      "source": "6.5, 6.6",
      "text": "Rename and move preserve canonical identity and historical paths.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestProjectionRenameMoveRetract"
      ]
    },
    {
      "id": "PH1-PART-005",
      "source": "6.6, 6.12-1",
      "text": "A part has zero or one current structural parent.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestProjectionRenameMoveRetract"
      ]
    },
    {
      "id": "PH1-PART-006",
      "source": "6.6, 6.12-3",
      "text": "Structural containment is temporal, provenance-bearing, and acyclic.",
      "tests": [
        "TestCycleRejected",
        "TestNestedPartRenameMoveRetractHistory",
        "TestProjectionRenameMoveRetract",
        "TestValidateAppendRejectsCycleAndCollision"
      ]
    },
    {
      "id": "PH1-PART-007",
      "source": "6.12-9, 7.4",
      "text": "Paths are unique within one ticket and selected time projection.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestValidateAppendRejectsCycleAndCollision"
      ]
    },
    {
      "id": "PH1-PART-008",
      "source": "6.7, 6.12-7",
      "text": "No value, type, status, or permission cascades by default without explicit ontology/policy.",
      "tests": [
        "TestParentValueRetractionPreservesChild"
      ]
    },
    {
      "id": "PH1-PART-009",
      "source": "6.11",
      "text": "Parent value retraction does not retract descendants; recursive removal is explicit and atomic.",
      "tests": [
        "TestParentValueRetractionPreservesChild",
        "TestRecursiveRetractionRemovesSubtree"
      ]
    },
    {
      "id": "PH1-PART-010",
      "source": "6.8, 6.12-8",
      "text": "Work decomposition uses linked tickets, not hidden subpart workflows.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PART-011",
      "source": "7.4",
      "text": "Part path segments use the recommended syntax and resolve under the selected projection.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestResolvePartPath",
        "TestValidatePathSegmentsRejectsInvalid"
      ]
    },
    {
      "id": "PH1-PART-012",
      "source": "6.3",
      "text": "Conventional part names are recognized but remain open-world.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PART-013",
      "source": "6.9",
      "text": "Stored values retain a declared media type or value kind.",
      "tests": [
        "TestAddListAppend"
      ]
    },
    {
      "id": "PH1-PRJ-001",
      "source": "4.4, 20.3-7",
      "text": "Current ticket state is a derived projection; the event ledger is authoritative.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-PRJ-002",
      "source": "4.4, 10.2",
      "text": "Valid-time projection is supported.",
      "tests": [
        "TestBitemporalProjection",
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PRJ-003",
      "source": "4.4, 10.2",
      "text": "Bitemporal projection is supported.",
      "tests": [
        "TestBitemporalProjection",
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PRJ-004",
      "source": "6.6, 7.4",
      "text": "Part path resolution is temporal and projection-scoped.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PRJ-005",
      "source": "20.3-2",
      "text": "Same events, ontology versions, and projection rules produce the same state.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory",
        "TestProjectionRenameMoveRetract",
        "TestReproducibleProjection"
      ]
    },
    {
      "id": "PH1-PRV-001",
      "source": "11.2",
      "text": "Events support actor, sources, inputs, causes, effects, supersedes, ontology versions, and batch ID.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PRV-002",
      "source": "11.3",
      "text": "Intention, action, effect, observation, and verification are distinct provenance facts.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-PRV-003",
      "source": "11.4",
      "text": "Agent and process runs have stable references.",
      "tests": [
        "TestNewShowSetLifecycle"
      ]
    },
    {
      "id": "PH1-PRV-004",
      "source": "11.6",
      "text": "Expected external effects are recorded when policy requires them.",
      "tests": [
        "TestNestedPartRenameMoveRetractHistory"
      ]
    },
    {
      "id": "PH1-REF-001",
      "source": "7.1, 18.1",
      "text": "`Ref` covers ticket, part, event, project, group, run, code, git, and artifact.",
